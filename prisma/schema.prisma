generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailBlastStatus {
  draft
  pending_approval
  approved
  rejected
  sent
}

model EmailBlast {
  id              String            @id @default(cuid())
  subject         String
  body            String
  contentMode     String            @default("text")
  senderName      String?
  senderEmail     String?
  replyToEmail    String?
  status          EmailBlastStatus  @default(draft)
  composedBy      String
  approvedBy      String?
  rejectedBy      String?
  rejectionReason String?
  sentAt          DateTime?
  sentCount       Int               @default(0)
  departmentId    String
  isArchived      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  recipients      EmailBlastRecipient[]
  attachments     EmailBlastAttachment[]

  @@index([departmentId, createdAt])
  @@index([status])
}

model EmailBlastRecipient {
  id      String     @id @default(cuid())
  blastId String
  email   String
  blast   EmailBlast @relation(fields: [blastId], references: [id], onDelete: Cascade)

  @@index([blastId])
  @@index([email])
  @@unique([blastId, email])
}

model EmailBlastAttachment {
  id             String     @id @default(cuid())
  blastId        String
  kind           String
  storageKey     String
  publicUrl      String?
  filename       String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  uploadedBy     String
  createdAt      DateTime   @default(now())
  blast          EmailBlast @relation(fields: [blastId], references: [id], onDelete: Cascade)

  @@index([blastId, createdAt])
  @@index([checksumSha256])
  @@unique([blastId, checksumSha256])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  displayName   String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model FinanceTransaction {
  id                String   @id @default(cuid())
  title             String
  amount            Int
  type              String   @default("expense")
  transactionDate   DateTime
  departmentId      String
  createdBy         String
  createdAt         DateTime @default(now())
  programBudgetId   String?
  category          String?
  updatedAt         DateTime @updatedAt

  @@index([departmentId, createdAt])
  @@index([type])
  @@index([programBudgetId])
}

model FinanceProgramBudget {
  id              String   @id @default(cuid())
  name            String
  allocatedAmount Int
  departmentId    String
  createdBy       String
  createdAt       DateTime @default(now())
  endDate         DateTime?
  updatedAt       DateTime @updatedAt

  @@index([departmentId, createdAt])
}

// ---------------------------------------------------------------------------
// Organisational models
// ---------------------------------------------------------------------------

enum MembershipRole {
  head
  manager
  member
}

model Department {
  id        String           @id
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  members   UserDepartment[]
}

model UserDepartment {
  id             String         @id @default(cuid())
  userId         String
  departmentId   String
  membershipRole MembershipRole
  createdAt      DateTime       @default(now())
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// HR
// ---------------------------------------------------------------------------

enum HrMemberStatus {
  active
  inactive
  probation
  on_leave
}

model HrMember {
  id           String         @id @default(cuid())
  userId       String
  position     String         @db.VarChar(255)
  joinDate     DateTime       @db.Date
  status       HrMemberStatus @default(active)
  departmentId String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([departmentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

model MarketingCampaign {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(255)
  platform     String   @db.VarChar(100)
  budget       Float
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

enum OperationsTaskStatus {
  todo
  in_progress
  blocked
  done
}

model OperationsTask {
  id           String               @id @default(cuid())
  title        String               @db.VarChar(255)
  status       OperationsTaskStatus @default(todo)
  deadline     DateTime             @db.Date
  assignedTo   String
  departmentId String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([departmentId])
  @@index([assignedTo])
}

// ---------------------------------------------------------------------------
// Analytics / Reports
// ---------------------------------------------------------------------------

enum ReportStatus {
  pending
  approved
}

model AnalyticsReport {
  id           String       @id @default(cuid())
  title        String       @db.VarChar(255)
  fileUrl      String       @default("")
  reportDate   String       @default("")
  fileSize     String       @default("")
  status       ReportStatus @default(pending)
  departmentId String
  createdBy    String
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([departmentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  resourceType String
  resourceId   String?
  payload      Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([resourceType, resourceId])
}

